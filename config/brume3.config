# ============================================================================
#  GL.iNet GL-MT5000 (Brume 3) – eigenes OpenWrt-Image
#  Basis: GL.iNet-Branch "mt5000" (= OpenWrt main + PR #24237, Kernel 6.18)
#  Wird von "make defconfig" vervollständigt. Pakete hier ergänzen/entfernen.
# ============================================================================

# ---- Zielgerät ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- Build-Beschleunigung ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---- Weboberfläche ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# ---- WireGuard (Fernzugriff) ----
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# ---- DynDNS (deSEC) ----
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ---- SQM / Bufferbloat (cake) ----
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-sched-cake=y

# ---- Bandbreite pro Gerät ----
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ---- Zugriff für Home Assistant über ubus/HTTP ----
# (luci-mod-rpc wurde 08/2026 aus LuCI entfernt; Nachfolger ist ubus über HTTP)
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# ---- MQTT-Client für lease2mqtt (Lease-Liste an Home Assistant) ----
CONFIG_PACKAGE_mosquitto-client-nossl=y

# ---- Statistik (wie im bisherigen dsouza-Build) ----
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-ping=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# ---- Werkzeuge ----
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
